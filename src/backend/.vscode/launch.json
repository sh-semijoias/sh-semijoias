{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: dotnet run",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/Api/bin/Debug/net10.0/Api.dll",
      "cwd": "${workspaceFolder}/Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5224"
      }
    }
  ]
}
