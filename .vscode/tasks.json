{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: up",
      "type": "shell",
      "command": "docker compose up -d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "ng: stop",
      "type": "shell",
      "command": "pkill -f 'ng serve' || true",
      "windows": {
        "command": "powershell -Command \"Get-Process -Name 'node' -ErrorAction SilentlyContinue | Stop-Process -Force\""
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "dotnet: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/backend/Api/Api.csproj"],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: wait",
      "type": "shell",
      "command": "until curl -sf http://localhost:5224/scalar/v1 > /dev/null; do sleep 1; done",
      "windows": {
        "command": "powershell -Command \"while (-not (try { Invoke-WebRequest -Uri http://localhost:5224/scalar/v1 -UseBasicParsing -ErrorAction Stop; $true } catch { $false })) { Start-Sleep 1 }\""
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "ng: serve",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/src/frontend"
      },
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "npm: start",
      "dependsOn": ["backend: wait", "ng: serve"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "start: dependencies",
      "dependsOn": ["docker: up", "ng: serve"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "stop: all",
      "dependsOn": ["docker: down", "ng: stop"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "ng: test",
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/src/frontend"
      },
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    }
  ]
}
