{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: dotnet run",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "postDebugTask": "docker: down",
      "program": "${workspaceFolder}/src/backend/Api/bin/Debug/net10.0/Api.dll",
      "cwd": "${workspaceFolder}/src/backend/Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5224"
      }
    },
    {
      "name": "Frontend: ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Frontend: ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    }
  ],
  "compounds": [
    {
      "name": "Start all",
      "configurations": ["Backend: dotnet run", "Frontend: ng serve"],
      "preLaunchTask": "docker: up",
      "stopAll": true,
      "presentation": {
        "default": true
      }
    }
  ]
}
