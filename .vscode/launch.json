{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: dotnet run",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "postDebugTask": "stop: all",
      "program": "${workspaceFolder}/src/backend/Api/bin/Debug/net10.0/Api.dll",
      "cwd": "${workspaceFolder}/src/backend/Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5224"
      },
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Frontend: chrome",
        "pattern": "Now listening on"
      }
    },
    {
      "name": "Frontend: chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/",
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-profile",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Frontend: ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "postDebugTask": "ng: stop",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Frontend: ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    }
  ],
  "compounds": [
    {
      "name": "Start all",
      "configurations": ["Backend: dotnet run"],
      "preLaunchTask": "start: dependencies",
      "stopAll": true,
      "presentation": {
        "default": true
      }
    }
  ]
}
